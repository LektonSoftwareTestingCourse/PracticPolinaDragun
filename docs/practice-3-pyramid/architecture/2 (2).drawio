        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {\&quot;flowchart\&quot;: {\&quot;nodeSpacing\&quot;: 25, \&quot;rankSpacing\&quot;: 35, \&quot;padding\&quot;: 8, \&quot;curve\&quot;: \&quot;basis\&quot;}}}%%\nflowchart TB\n    subgraph Simulators[\&quot;Эмуляторы\&quot;]\n        TERM[\&quot;Terminal Sim :8085\&quot;]\n        MERCH[\&quot;Merchant+Acquirer Sim :8084\&quot;]\n    end\n    subgraph GatewayLayer[\&quot;API Gateway\&quot;]\n        GW[\&quot;Gateway :8080\&quot;]\n    end\n    subgraph Core[\&quot;Core Processing\&quot;]\n        SW[\&quot;Switch :8082\&quot;]\n        AUTH[\&quot;Authorization :8083\&quot;]\n        CMS[\&quot;Card Management :8081&lt;br/&gt;+ outbox\&quot;]\n    end\n    subgraph External[\&quot;External API\&quot;]\n        BIN[\&quot;Bin Lookup :8096\&quot;]\n    end\n    subgraph Notif[\&quot;Notifications\&quot;]\n        NS[\&quot;Notification :8097\&quot;]\n    end\n    subgraph LoggingLayer[\&quot;Logging\&quot;]\n        LOG[\&quot;Transaction Logger :8088&lt;br/&gt;+ WebSocket\&quot;]\n    end\n    subgraph Frontend[\&quot;Frontend\&quot;]\n        WEB[\&quot;Web Dashboard :3000\&quot;]\n    end\n    subgraph Infra[\&quot;Infrastructure\&quot;]\n        DB[(\&quot;PostgreSQL :5432\&quot;)]\n        RMQ{{\&quot;RabbitMQ :5672&lt;br/&gt;smp.transactions → transaction-log&lt;br/&gt;smp.card-events → card-notifications&lt;br/&gt;+ DLX/DLQ\&quot;}}\n        ASC[\&quot;autoscaler&lt;br/&gt;profile observability&lt;br/&gt;вне потока\&quot;]\n    end\n\n    %% исходные связи architecture-diagram.puml (0-11)\n    TERM --&gt;|\&quot;HTTP\&quot;| GW\n    MERCH --&gt;|\&quot;HTTP\&quot;| GW\n    GW --&gt;|\&quot;HTTP /route\&quot;| SW\n    SW --&gt;|\&quot;HTTP /authorize, /rollback\&quot;| AUTH\n    AUTH --&gt;|\&quot;HTTP /api/bin\&quot;| BIN\n    AUTH --&gt;|\&quot;HTTP card, reserve\&quot;| CMS\n    CMS --&gt;|\&quot;JDBC\&quot;| DB\n    NS --&gt;|\&quot;JDBC\&quot;| DB\n    LOG --&gt;|\&quot;JDBC