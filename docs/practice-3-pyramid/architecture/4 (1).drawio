<mxfile host="app.diagrams.net">
  <diagram name="Страница-1" id="zJdzNPa6uHMzNS-lk9RP">
    <mxGraphModel dx="5150" dy="3290" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor T as Terminal Simulator\n    participant GW as Gateway\n    participant SW as Switch\n    participant AUTH as Authorization\n    participant CMS as Card Management\n    participant BIN as Bin Lookup\n    participant RMQ as RabbitMQ\n    participant LOG as Logger\n    participant NS as Notification Service\n\n    T-&gt;&gt;GW: POST /api/transactions (auth request)\n    GW-&gt;&gt;GW: validate request\n    GW-&gt;&gt;SW: forward transaction\n    SW-&gt;&gt;SW: extract BIN, route to issuer\n    SW-&gt;&gt;AUTH: POST /api/internal/authorize (AuthorizationRequest + issuerId)\n    AUTH-&gt;&gt;BIN: GET /api/bin/{bin} (enrich issuerId)\n    BIN--&gt;&gt;AUTH: BinLookupResponse {issuerId, ...}\n    AUTH-&gt;&gt;CMS: GET /api/cards/{pan}\n    CMS--&gt;&gt;AUTH: Card {id, status, limits, ...}\n    AUTH-&gt;&gt;AUTH: check status, expiry, limits, balance\n    alt approved\n        AUTH-&gt;&gt;CMS: POST /api/cards/{pan}/reserve {amount, rrn}\n        CMS--&gt;&gt;AUTH: OK\n        CMS--&gt;&gt;RMQ: Publish card event (outbox)\n        AUTH-&gt;&gt;AUTH: generate RRN, authCode\n        AUTH--&gt;&gt;SW: AuthResponse {approved, rrn, authCode}\n    else declined\n        AUTH--&gt;&gt;SW: AuthResponse {declined, reason}\n    else declined: карта BLOCKED [ДОБАВЛЕНО]\n        rect rgb(200, 240, 200)\n            Note over AUTH: card.status == BLOCKED → DeclineOutcome.CARD_BLOCKED\n            AUTH--&gt;&gt;SW: AuthResponse {declined, reason CARD_BLOCKED, responseCode 05} (HTTP 403)\n        end\n    end\n    SW-&gt;&gt;RMQ: Publish Transaction (async)\n    alt Publisher Confirm: ack ≤ 2 с [ДОБАВЛЕНО]\n        rect rgb(200, 240, 200)\n            RMQ--&gt;&gt;SW: basic.ack → ConfirmCallback(correlationData, ack=true)\n        end\n    SW--&gt;&gt;GW: TransactionResponse\n    GW--&gt;&gt;T: HTTP 200 {approved|declined, ...}\n    RMQ--&gt;&gt;LOG: Consume Transaction\n    LOG-&gt;&gt;LOG: Save to DB\n    RMQ--&gt;&gt;NS: Consume card event\n    NS-&gt;&gt;NS: Save notification\n    else nack или нет ack за 2 с [ДОБАВЛЕНО]\n        rect rgb(200, 240, 200)\n            RMQ--xSW: basic.nack → ConfirmCallback(correlationData, ack=false) / confirm timeout 2s\n            alt Сценарий 3: reversal — транзакция APPROVED\n                SW-&gt;&gt;AUTH: POST /api/internal/rollback (RollbackRequest {rrn, pan, amount}, reversal mti \&quot;0400\&quot;)\n                AUTH-&gt;&gt;CMS: POST /api/cards/{pan}/rollback {amount, rrn}\n                CMS-&gt;&gt;CMS: findByRrnAndPanForUpdate(rrn, pan)\n                CMS-&gt;&gt;CMS: reservation RESERVED → ROLLED_BACK, availableBalance += amount\n                CMS--&gt;&gt;AUTH: OK\n                CMS-)RMQ: Publish card event (outbox)\n                AUTH-&gt;&gt;AUTH: release limit_usage {pan, amount}\n                AUTH--&gt;&gt;SW: RollbackResponse {approved}\n                SW--&gt;&gt;GW: TransactionResponse {declined, responseCode 96}\n                GW--&gt;&gt;T: HTTP 200 {declined, responseCode 96}\n                RMQ-)NS: Consume card event\n                NS-&gt;&gt;NS: Save notification\n            else транзакция DECLINED\n                SW--&gt;&gt;GW: TransactionResponse {declined, reason}\n                GW--&gt;&gt;T: HTTP 200 {declined, ...}\n            end\n        end\n    end\n    end\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="nDBQNLLxSZzEVm29IGxB-700">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fontFamily=Helvetica;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
