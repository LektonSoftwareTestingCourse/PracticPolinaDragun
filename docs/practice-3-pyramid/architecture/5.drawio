        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    SW[\&quot;Switch&lt;br/&gt;LoggerClient\&quot;]\n    CMS[\&quot;Card-Management&lt;br/&gt;OutboxProcessor\&quot;]\n    LOG[\&quot;Transaction Logger&lt;br/&gt;TransactionLogListener\&quot;]\n    NS[\&quot;Notification Service&lt;br/&gt;CardEventListener\&quot;]\n\n    subgraph rmq[\&quot;RabbitMQ\&quot;]\n        subgraph f1[\&quot;Поток транзакций\&quot;]\n            EX1{{\&quot;EXCHANGE smp.transactions&lt;br/&gt;topic, durable\&quot;}}\n            Q1[\&quot;QUEUE transaction-log&lt;br/&gt;durable, DLX, x-max-delivery=3\&quot;]\n            DLX1{{\&quot;DLX smp.transactions.dlx&lt;br/&gt;direct\&quot;}}\n            DLQ1[\&quot;DLQ transaction-log-dlq&lt;br/&gt;TTL 60000 ms\&quot;]\n        end\n        subgraph f2[\&quot;Поток событий карт\&quot;]\n            EX2{{\&quot;EXCHANGE smp.card-events&lt;br/&gt;topic, durable\&quot;}}\n            Q2[\&quot;QUEUE card-notifications&lt;br/&gt;durable, DLX, x-max-delivery=3\&quot;]\n            DLX2{{\&quot;DLX smp.card-events.dlx&lt;br/&gt;direct\&quot;}}\n            DLQ2[\&quot;DLQ card-notifications-dlq&lt;br/&gt;TTL 60000 ms\&quot;]\n        end\n    end\n\n    SW --&gt;|\&quot;publish key=transaction.log&lt;br/&gt;confirm: correlated&lt;br/&gt;по ТЗ 2 с, callback в коде нет\&quot;| EX1\n    EX1 --&gt;|\&quot;binding transaction.log\&quot;| Q1\n    Q1 --&gt;|\&quot;consume → store()\&quot;| LOG\n    Q1 -.-&gt;|\&quot;отказ после 3 доставок\&quot;| DLX1\n    DLX1 --&gt;|\&quot;key=transaction-log\&quot;| DLQ1\n\n    CMS --&gt;|\&quot;publish key=card.EventClass&lt;br/&gt;Outbox retry до 3 → FAILED\&quot;| EX2\n    EX2 --&gt;|\&quot;binding card.*\&quot;| Q2\n    Q2 --&gt;|\&quot;consume → INSERT card_notifications\&quot;| NS\n    Q2 -.-&gt;|\&quot;отказ после 3 доставок\&quot;| DLX2\n    DLX2 --&gt;|\&quot;key=card-notifications\&quot;| DLQ2\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="TKJ_N2HU5VkLUK7UPfeS-1">
